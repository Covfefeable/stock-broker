COMPOSE_PROJECT_NAME=stock-broker

EXPOSE_HTTP_PORT=80
EXPOSE_HTTPS_PORT=443
ENABLE_SSL=false
SSL_CERT_FILE=server.crt
SSL_KEY_FILE=server.key

DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=stock_broker
DB_PORT=5432

POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=128MB
POSTGRES_WORK_MEM=4MB
POSTGRES_MAINTENANCE_WORK_MEM=64MB
POSTGRES_EFFECTIVE_CACHE_SIZE=4096MB
POSTGRES_STATEMENT_TIMEOUT=0
POSTGRES_IDLE_IN_TRANSACTION_SESSION_TIMEOUT=0

REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_BEAT_SCHEDULE_FILENAME=

APP_ENV=production
SECRET_KEY=replace-this-secret
JWT_SECRET_KEY=replace-this-jwt-secret
JWT_ACCESS_TOKEN_EXPIRES=604800
RUN_MIGRATIONS=true
SYNC_TASK_TIMEOUT_SECONDS=3600
CORS_ORIGINS=http://localhost:3000

SERVER_WORKER_AMOUNT=1
SERVER_WORKER_CLASS=gevent
SERVER_WORKER_CONNECTIONS=1000
GUNICORN_TIMEOUT=360

NEXT_PUBLIC_API_BASE_URL=/api
